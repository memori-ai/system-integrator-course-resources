<% content_for :title, "Demo 1 - Web Component Programming" %>

<div class="container py-5">

  <%# Back to Home %>
  <div class="row mb-4">
    <div class="col">
      <%= link_to root_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i> Back to Demo Selection
      <% end %>
    </div>
  </div>

  <%# Hero Section %>
  <div class="row mb-5">
    <div class="col-lg-8 mx-auto text-center">
      <span class="badge bg-success mb-3">Demo 1</span>
      <h1 class="display-5 fw-bold mb-3">
        <i class="bi bi-puzzle text-success me-2"></i>
        TODO: Add Demo Title
      </h1>
      <p class="lead text-muted">
        TODO: Add demo description.
      </p>
    </div>
  </div>

  <%# Configuration Form %>
  <% unless @show_agent %>
    <div class="row mb-5">
      <div class="col-lg-8 mx-auto">
        <div class="card border-0 shadow">
          <div class="card-header bg-success text-white">
            <h5 class="mb-0">
              <i class="bi bi-gear me-2"></i>
              Configure Agent
            </h5>
          </div>
          <div class="card-body p-4">
            <%= form_with url: demo1_configure_path, method: :post, local: true do |f| %>
              <div class="mb-3">
                <%= f.label :memori_id, "Agent ID (memori_id)", class: "form-label fw-bold" %>
                <%= f.text_field :memori_id, class: "form-control", placeholder: "e.g. xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx", value: @memori_id %>
              </div>
              <div class="mb-3">
                <%= f.label :owner_user_id, "Owner User ID", class: "form-label fw-bold" %>
                <%= f.text_field :owner_user_id, class: "form-control", placeholder: "e.g. xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx", value: @owner_user_id %>
              </div>
              <div class="mb-3">
                <%= f.label :tenant_id, "Tenant ID", class: "form-label fw-bold" %>
                <%= f.text_field :tenant_id, class: "form-control", value: @tenant_id %>
              </div>
              <div class="d-grid">
                <%= f.submit "Load Agent", class: "btn btn-success btn-lg" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Agent Web Component %>
  <% if @show_agent %>
    <div class="row">
      <div class="col-lg-10 mx-auto">
        <div class="card border-0 shadow">
          <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
              <i class="bi bi-robot me-2"></i>
              Agent
            </h5>
            <%= link_to demo1_path, class: "btn btn-outline-light btn-sm" do %>
              <i class="bi bi-gear me-1"></i> Reconfigure
            <% end %>
          </div>
          <div class="memori-container">
            <memori-client
              memori-name=""
              memori-id="<%= @memori_id %>"
              owner-user-id="<%= @owner_user_id %>"
              tenant-id="<%= @tenant_id %>"
              engine-url="<%= @engine_url %>"
              api-url="<%= @api_url %>"
              base-url="<%= @base_url %>"
              show-share-button="false"
            ></memori-client>
          </div>
        </div>
      </div>
    </div>
  <% end %>

</div>
