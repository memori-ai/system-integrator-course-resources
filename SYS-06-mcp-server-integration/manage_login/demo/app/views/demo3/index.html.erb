<% content_for :title, "Demo 3: Filesystem MCP Server" %>

<div class="container py-5">

  <%# Back to Home %>
  <div class="row mb-4">
    <div class="col">
      <%= link_to root_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i> Back to Demo Selection
      <% end %>
    </div>
  </div>

  <%# Hero Section %>
  <div class="row mb-5">
    <div class="col-lg-8 mx-auto text-center">
      <span class="badge mb-3 text-white" style="background: linear-gradient(135deg, #00a4ef 0%, #0078d4 100%);">Demo 3</span>
      <h1 class="display-5 fw-bold mb-3">
        <i class="bi bi-folder2-open me-2" style="color: #00a4ef;"></i>
        Filesystem MCP Server
      </h1>
      <p class="lead text-muted">
        Learn how to connect an AIsuru agent to a custom MCP filesystem server running in a
        separate Docker container. The agent can read, write, and create files in a shared
        workspace directory — and every change is immediately visible here.
      </p>
    </div>
  </div>

  <%# What is Filesystem MCP Server Card %>
  <div class="row mb-5">
    <div class="col-lg-10 mx-auto">
      <div class="card border-primary">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #00a4ef 0%, #0078d4 100%);">
          <h5 class="mb-0">
            <i class="bi bi-question-circle me-2"></i>
            What is the Filesystem MCP Server?
          </h5>
        </div>
        <div class="card-body">
          <p class="mb-3">
            The Filesystem MCP server is a lightweight Node.js process that exposes file-system
            operations through the <strong>Model Context Protocol</strong>.  It runs in its own
            Docker container and shares a directory with the demo application via a bind mount.
            Once an AIsuru agent is connected to it, the agent can manipulate files on that
            shared filesystem as part of a natural conversation.
          </p>
          <ul class="mb-0">
            <li class="mb-2">
              <strong>Secure access:</strong> The server only exposes a single directory
              (<code>/workspace</code> inside the container → <code>./test</code> on the host).
              Path-traversal attempts are rejected.
            </li>
            <li class="mb-2">
              <strong>Four tools:</strong>
              <code>list_files</code>, <code>read_file</code>, <code>write_file</code>,
              <code>create_file</code>
            </li>
            <li class="mb-2">
              <strong>Zero extra setup:</strong> <code>docker compose up</code> starts both the
              Rails demo and the MCP server in one command.
            </li>
            <li class="mb-2">
              <strong>Real-time proof:</strong> The "Workspace Files" panel on this page re-reads
              the directory on every page load, so any change the agent makes is immediately visible.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <%# Architecture overview %>
  <div class="row mb-5">
    <div class="col-lg-10 mx-auto">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0">
            <i class="bi bi-diagram-3 me-2"></i>
            Architecture Overview
          </h5>
        </div>
        <div class="card-body p-4">
          <div class="text-center">
            <div class="d-flex justify-content-center align-items-center flex-wrap gap-3">
              <%# User %>
              <div class="card border-success text-center p-3" style="min-width:120px;">
                <i class="bi bi-person-fill display-5 text-success"></i>
                <div class="fw-bold small mt-1">User</div>
              </div>
              <i class="bi bi-arrow-right fs-4 text-muted"></i>

              <%# AIsuru Agent %>
              <div class="card border-primary text-center p-3" style="min-width:140px;">
                <i class="bi bi-robot display-5 text-primary"></i>
                <div class="fw-bold small mt-1">AIsuru Agent</div>
                <div class="text-muted" style="font-size:0.7rem;">(web component)</div>
              </div>
              <i class="bi bi-arrow-right fs-4 text-muted"></i>

              <%# ngrok tunnel %>
              <div class="card border-secondary text-center p-3" style="min-width:120px;">
                <i class="bi bi-globe display-5 text-secondary"></i>
                <div class="fw-bold small mt-1">ngrok</div>
                <div class="text-muted" style="font-size:0.7rem;">(public tunnel)</div>
              </div>
              <i class="bi bi-arrow-right fs-4 text-muted"></i>

              <%# MCP Server %>
              <div class="card text-white text-center p-3" style="min-width:150px; background: linear-gradient(135deg, #00a4ef 0%, #0078d4 100%);">
                <i class="bi bi-hdd-network display-5"></i>
                <div class="fw-bold small mt-1">MCP Server</div>
                <div style="font-size:0.7rem;">(Docker · port 8000)</div>
              </div>
              <i class="bi bi-arrow-left-right fs-4 text-muted"></i>

              <%# Shared Filesystem %>
              <div class="card border-warning text-center p-3" style="min-width:130px;">
                <i class="bi bi-folder2 display-5 text-warning"></i>
                <div class="fw-bold small mt-1">Shared Folder</div>
                <div class="text-muted" style="font-size:0.7rem;"><code>./test</code></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Instructions Card %>
  <div class="row mb-5">
    <div class="col-lg-10 mx-auto">
      <div class="card border-info">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #00a4ef 0%, #0078d4 100%);">
          <h5 class="mb-0">
            <i class="bi bi-list-ol me-2"></i>
            Step-by-Step Guide
          </h5>
        </div>
        <div class="card-body">

          <h6 class="fw-bold mb-3">Part 1: Expose the MCP Server</h6>
          <ol class="mb-4">
            <li class="mb-2">
              The MCP server must be accessible from the internet so that the AIsuru agent can reach it.
              In this demo we use <strong>ngrok</strong> as a public tunnel, but any similar solution
              (e.g. a cloud-hosted reverse proxy) works the same way.
            </li>
            <li class="mb-2">
              <strong>Get an ngrok auth token:</strong> create an account at
              <a href="https://ngrok.com" target="_blank" rel="noopener">ngrok.com</a>.
              The auth token is available in your dashboard under the <strong>Connect</strong> section.
              Add it to the <code>.env_dev</code> file in the demo directory:
              <div class="bg-dark text-light p-3 rounded mt-2">
                <code>NGROK_AUTHTOKEN=your_token_here</code>
              </div>
            </li>
            <li class="mb-2">
              Start all containers with a single command:
              <div class="bg-dark text-light p-3 rounded mt-2">
                <code>docker compose up --build</code>
              </div>
              <div class="alert alert-info mt-2 small">
                <i class="bi bi-info-circle me-1"></i>
                This starts <strong>six services</strong>: <code>web</code> (Rails),
                <code>sidekiq</code>, <code>mongodb</code>, <code>redis</code>,
                <code>mcp-server</code> (filesystem tools on port 8000), and
                <code>ngrok</code> (public tunnel to the MCP server).
              </div>
            </li>
            <li class="mb-2">
              <strong>Get the public URL of the MCP server.</strong> You can do this in two ways:
              <ul class="mt-2">
                <li>
                  From the terminal, run:
                  <div class="bg-dark text-light p-3 rounded mt-2">
                    <code>docker compose logs ngrok</code>
                  </div>
                  Look for the line <code>Forwarding  https://…ngrok.app → …</code>.
                </li>
                <li>
                  Or log in to <a href="https://ngrok.com" target="_blank" rel="noopener">ngrok.com</a>
                  and go to the <strong>Connect</strong> section in your dashboard — the active tunnel URL is shown there.
                </li>
              </ul>
              <div class="alert alert-warning mt-2 small">
                <i class="bi bi-exclamation-triangle me-1"></i>
                The ngrok URL changes every time the container restarts.
                Always copy it fresh before configuring the agent.
              </div>
            </li>
          </ol>

          <h6 class="fw-bold mb-3 mt-4">Part 2: Create the Agent on AIsuru</h6>
          <ol start="5" class="mb-4">
            <li class="mb-2">
              <strong>Create a new Agent</strong> on the AIsuru Platform (or use an existing one).
            </li>
            <li class="mb-2">
              <strong>Go to Agent Settings → MCP Servers</strong> and click
              <strong>"Aggiungi MCP Personalizzato"</strong> to add a new custom MCP server.
              Set the URL to the public ngrok URL you copied in the previous step, with the path
              <code>/mcp</code> appended:
              <div class="bg-dark text-light p-3 rounded mt-2">
                <code>https://…ngrok.app/mcp</code>
              </div>
              The agent will automatically discover the available tools by connecting to this endpoint.
            </li>
          </ol>

          <h6 class="fw-bold mb-3 mt-4">Part 3: Configure the Agent Prompt</h6>
          <ol start="7" class="mb-4">
            <li class="mb-2">
              <strong>Go to Agent Settings → Prompt</strong>
            </li>
            <li class="mb-2">
              <strong>Add file-system instructions to the prompt.</strong>
              The agent will automatically detect the available tools from the MCP server,
              so you don't need to list them explicitly. A simple prompt is enough:
              <div class="alert alert-secondary mt-2 small">
                <strong>Example prompt:</strong><br>
                "You are a file-management assistant with access to a shared filesystem via MCP.
                Always confirm with the user before modifying or creating files."
              </div>
            </li>
            <li class="mb-2">
              <strong>Save the prompt.</strong>
            </li>
          </ol>

          <h6 class="fw-bold mb-3 mt-4">Part 4: Get Your Agent IDs</h6>
          <ol start="10" class="mb-4">
            <li class="mb-2">
              <strong>Open your Agent</strong> and click on <strong>"Dev docs"</strong> in the left sidebar.
            </li>
            <li class="mb-2">
              Expand the <strong>"▼ Other references"</strong> section.
            </li>
            <li class="mb-2">
              Copy the following values:
              <ul class="mt-2">
                <li><strong>Secondary Memori (Agent) ID</strong> → <code>memoriID</code></li>
                <li><strong>Owner user ID</strong> → <code>ownerUserID</code></li>
              </ul>
            </li>
            <li class="mb-2">
              <strong>Paste them in the configuration form below</strong> and click "Load Agent".
            </li>
          </ol>

          <h6 class="fw-bold mb-3 mt-4">Part 5: Test the Integration</h6>
          <ol start="14" class="mb-0">
            <li class="mb-2">
              Start a conversation with your agent in the web component that appears below.
            </li>
            <li class="mb-2">
              Ask the agent to <strong>list the files</strong> in the workspace.
            </li>
            <li class="mb-2">
              Ask the agent to <strong>read</strong> one of the existing files (e.g. <code>notes.md</code>).
            </li>
            <li class="mb-2">
              Ask the agent to <strong>modify</strong> a file or <strong>create a new one</strong>.
            </li>
            <li class="mb-2">
              Scroll down to the <strong>"Workspace Files"</strong> panel and refresh the page —
              the changes made by the agent will be visible there immediately.
            </li>
          </ol>
        </div>
      </div>
    </div>
  </div>

  <%# Configuration Form %>
  <div class="row mb-5">
    <div class="col-lg-10 mx-auto">
      <div class="card shadow">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #00a4ef 0%, #0078d4 100%);">
          <h5 class="mb-0">
            <i class="bi bi-gear me-2"></i>
            Configure Your Filesystem Agent
          </h5>
        </div>
        <div class="card-body p-4">
          <%= form_with url: demo3_configure_path, method: :post, local: true do |f| %>
            <div class="mb-4">
              <label for="memori_id" class="form-label fw-bold">
                <i class="bi bi-fingerprint me-1"></i>
                Memori ID (Secondary Agent ID)
              </label>
              <%= f.text_field :memori_id,
                  class: "form-control form-control-lg",
                  placeholder: "e.g., a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                  required: true,
                  pattern: "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" %>
              <div class="form-text">
                Found in Dev docs → Other references → "Secondary Memori (Agent) ID"
              </div>
            </div>

            <div class="mb-4">
              <label for="owner_user_id" class="form-label fw-bold">
                <i class="bi bi-person-badge me-1"></i>
                Owner User ID
              </label>
              <%= f.text_field :owner_user_id,
                  class: "form-control form-control-lg",
                  placeholder: "e.g., b2c3d4e5-f6a7-8901-bcde-f12345678901",
                  required: true,
                  pattern: "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" %>
              <div class="form-text">
                Found in Dev docs → Other references → "Owner user ID"
              </div>
            </div>

            <hr class="my-4">
            <h6 class="text-muted mb-3">
              <i class="bi bi-sliders me-1"></i>
              Advanced Configuration (pre-filled with defaults)
            </h6>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="tenant_id" class="form-label">
                  <i class="bi bi-building me-1"></i>
                  Tenant ID
                </label>
                <%= f.text_field :tenant_id,
                    class: "form-control",
                    value: @tenant_id || "www.aisuru.com",
                    required: true %>
              </div>

              <div class="col-md-6 mb-3">
                <label for="base_url" class="form-label">
                  <i class="bi bi-link-45deg me-1"></i>
                  Base URL
                </label>
                <%= f.text_field :base_url,
                    class: "form-control",
                    value: @base_url || "https://www.aisuru.com",
                    required: true %>
              </div>
            </div>

            <div class="mb-3">
              <label for="engine_url" class="form-label">
                <i class="bi bi-cpu me-1"></i>
                Engine URL
              </label>
              <%= f.text_field :engine_url,
                  class: "form-control",
                  value: @engine_url || "https://engine.memori.ai/memori/v2",
                  required: true %>
            </div>

            <div class="mb-4">
              <label for="api_url" class="form-label">
                <i class="bi bi-server me-1"></i>
                API URL
              </label>
              <%= f.text_field :api_url,
                  class: "form-control",
                  value: @api_url || "https://backend.memori.ai/api/v2",
                  required: true %>
            </div>

            <div class="d-grid">
              <%= f.submit "Load Filesystem Agent", class: "btn btn-lg text-white", style: "background: linear-gradient(135deg, #00a4ef 0%, #0078d4 100%);" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if @show_agent %>
    <%# Agent Success Alert %>
    <div class="row mb-4">
      <div class="col-lg-10 mx-auto">
        <div class="alert alert-success d-flex align-items-center">
          <i class="bi bi-check-circle-fill me-2 fs-4"></i>
          <div>
            <strong>Filesystem Agent Loaded!</strong>
            Try asking: "List the files in the workspace", "Read notes.md", or "Create a new file called hello.txt".
            Click any file in the explorer on the left to preview its content.
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Agent + File Explorer side by side (always visible) %>
  <div class="row mb-5 g-4">

    <%# Left column — Agent chat %>
    <div class="col-lg-6">
      <div class="card shadow h-100 d-flex flex-column">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #00a4ef 0%, #0078d4 100%);">
          <h5 class="mb-0">
            <i class="bi bi-robot me-2"></i>
            Your Filesystem Agent
          </h5>
        </div>
        <div class="card-body p-0 flex-grow-1">
          <% if @show_agent %>
            <div class="memori-container">
              <memori-client
                memoriName="FilesystemAgent"
                ownerUserName="owner"
                memoriID="<%= @memori_id %>"
                ownerUserID="<%= @owner_user_id %>"
                tenantID="<%= @tenant_id %>"
                engineURL="<%= @engine_url %>"
                apiURL="<%= @api_url %>"
                baseURL="<%= @base_url %>"
                layout="CHAT"
                uiLang="EN"
                spokenLang="EN"
                showLogin="true"
              ></memori-client>
            </div>
          <% else %>
            <div class="d-flex flex-column align-items-center justify-content-center text-muted p-5" style="height: 600px;">
              <i class="bi bi-gear display-4 d-block mb-3" style="color: #00a4ef;"></i>
              <p class="text-center mb-0">
                Fill in the <strong>Memori ID</strong> and <strong>Owner User ID</strong> in the form above
                and click <strong>Load Filesystem Agent</strong> to start the conversation.
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Right column — File Explorer %>
    <div class="col-lg-6">
      <div class="card shadow h-100 border-warning d-flex flex-column">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
          <h5 class="mb-0">
            <i class="bi bi-folder2-open me-2"></i>
            Explorer — <code>test/</code>
          </h5>
          <button type="button" class="btn btn-sm btn-outline-dark" id="explorer-refresh-btn">
            <i class="bi bi-arrow-repeat me-1"></i> Refresh
          </button>
        </div>

        <%# Tree %>
        <div id="explorer-tree-container" class="border-bottom" style="background:#1e1e1e; padding: 10px 14px; overflow-y:auto; max-height:280px;">
          <%= render partial: "demo3/explorer_tree" %>
        </div>

        <%# Preview pane %>
        <div class="flex-grow-1 d-flex flex-column" style="min-height:0;">
          <div class="px-3 py-2 border-bottom" style="background:#252526; color:#aaa; font-size:0.8rem;">
            <i class="bi bi-file-earmark-code me-1"></i>
            <span id="explorer-preview-title">Seleziona un file dal tree</span>
          </div>
          <div id="explorer-preview-body" class="flex-grow-1 overflow-auto p-3"
               style="background:#1e1e1e; color:#d4d4d4; font-size:0.82rem;">
            <pre class="mb-0" style="white-space:pre-wrap; color:#d4d4d4;"
                 id="explorer-preview-code">← click su un file sopra</pre>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Explorer styles + JS (scoped) %>
  <style>
    .explorer-tree { list-style: none; margin: 0; padding: 0; }
    .explorer-tree .explorer-node { font-size: 0.82rem; color: #ccc; }
    .explorer-tree .explorer-node .node-row {
      display: flex; align-items: center; gap: 4px;
      padding: 2px 0; cursor: pointer; border-radius: 3px;
      white-space: nowrap; user-select: none;
    }
    .explorer-tree .explorer-node .node-row:hover { background: rgba(255,255,255,0.06); }
    .explorer-tree .explorer-node .node-row.active { background: #264f78; color: #fff; }
    .explorer-tree .explorer-node .node-row .node-icon { width: 18px; text-align: center; flex-shrink: 0; }
    .explorer-tree .explorer-node .node-row .chevron { width: 16px; text-align: center; flex-shrink: 0; color: #888; font-size: 0.7rem; }
    .explorer-tree .explorer-node .node-row .chevron.open { transform: rotate(90deg); }
    .explorer-tree .explorer-node .node-children { padding-left: 20px; }
    .explorer-tree .explorer-node .node-children.hidden { display: none; }
  </style>

  <%# Docker Compose snippet %>
  <div class="row mb-5">
    <div class="col-lg-10 mx-auto">
      <div class="card border-dark">
        <div class="card-header bg-dark text-white">
          <h6 class="mb-0">
            <i class="bi bi-box me-2"></i>
            docker-compose.yml — MCP Server Service
          </h6>
        </div>
        <div class="card-body bg-light">
          <pre class="mb-0"><code># The mcp-server service is defined alongside the existing web, sidekiq,
# mongodb and redis services.  It shares the ./test directory with the
# web container so that both can read and write the same files.
# The ngrok sidecar tunnels port 8000 to a public HTTPS URL.

mcp-server:
  build:
    context: ./docker/mcp-server
    dockerfile: Dockerfile
  image: sys-06-mcp-filesystem-server
  ports:
    - "8000:8000"
  volumes:
    - ./test:/workspace        # shared with web at /rails/test
  environment:
    - WORKSPACE_ROOT=/workspace
    - PORT=8000

ngrok:
  image: ngrok/ngrok:latest
  command: http mcp-server:8000 --log=stdout
  environment:
    - NGROK_AUTHTOKEN=${NGROK_AUTHTOKEN}   # set in .env_dev
  depends_on:
    - mcp-server</code></pre>
        </div>
      </div>
    </div>
  </div>

  <%# Info Cards %>
  <div class="row">
    <div class="col-md-4 mb-4">
      <div class="card h-100 card-hover border-0 shadow-sm">
        <div class="card-body text-center p-4">
          <i class="bi bi-shield-check display-4 mb-3" style="color: #00a4ef;"></i>
          <h5 class="card-title">Secure by Design</h5>
          <p class="card-text text-muted">
            The MCP server only exposes the <code>/workspace</code> directory.
            Any path-traversal attempt (e.g. <code>../../etc/passwd</code>) is rejected
            before touching the filesystem.
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-4">
      <div class="card h-100 card-hover border-0 shadow-sm">
        <div class="card-body text-center p-4">
          <i class="bi bi-lightning-charge display-4 mb-3" style="color: #0078d4;"></i>
          <h5 class="card-title">One Command</h5>
          <p class="card-text text-muted">
            <code>docker compose up</code> starts everything: the Rails app, background workers,
            databases, the MCP server, and the ngrok tunnel — no manual steps required.
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-4">
      <div class="card h-100 card-hover border-0 shadow-sm">
        <div class="card-body text-center p-4">
          <i class="bi bi-arrow-repeat display-4 text-info mb-3"></i>
          <h5 class="card-title">Real-Time Proof</h5>
          <p class="card-text text-muted">
            Every file the agent creates or modifies is written to the shared bind mount.
            Refresh the "Workspace Files" panel above to see the result instantly.
          </p>
        </div>
      </div>
    </div>
  </div>

  <%# Security Warning %>
  <div class="row mt-4">
    <div class="col-lg-10 mx-auto">
      <div class="card border-danger">
        <div class="card-header bg-danger text-white">
          <h6 class="mb-0">
            <i class="bi bi-exclamation-octagon me-2"></i>
            Security Best Practices
          </h6>
        </div>
        <div class="card-body">
          <ul class="mb-0">
            <li class="mb-2">
              <strong>Restrict directory access:</strong> Only mount directories the agent
              absolutely needs.  This demo uses a dedicated <code>test/</code> folder.
            </li>
            <li class="mb-2">
              <strong>Use read-only mounts when possible:</strong> If the agent only needs to
              read files, add <code>:ro</code> to the volume mount in docker-compose.
            </li>
            <li class="mb-2">
              <strong>Never expose sensitive directories:</strong> Keep system directories,
              credentials, and personal files out of scope.
            </li>
            <li class="mb-2">
              <strong>Monitor agent actions:</strong> Regularly review what files the agent has
              accessed or modified.  The "Workspace Files" panel makes this easy.
            </li>
            <li class="mb-2">
              <strong>Set up backups:</strong> Always back up important files before giving an
              agent write access to a directory.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <%# Additional Tips %>
  <div class="row mt-4">
    <div class="col-lg-10 mx-auto">
      <div class="card border-warning">
        <div class="card-header bg-warning text-dark">
          <h6 class="mb-0">
            <i class="bi bi-lightbulb me-2"></i>
            Tips & Troubleshooting
          </h6>
        </div>
        <div class="card-body">
          <ul class="mb-0">
            <li class="mb-2">
              <strong>MCP server not responding:</strong> Run <code>docker compose logs mcp-server</code>
              to check for startup errors.
            </li>
            <li class="mb-2">
              <strong>Permission errors:</strong> On Linux/macOS the bind-mounted directory inherits
              the host user's permissions.  Make sure <code>./test</code> is writable.
            </li>
            <li class="mb-2">
              <strong>Files not appearing:</strong> The "Workspace Files" panel is a server-side
              snapshot — hit the <strong>Refresh</strong> button (or reload the page) after the agent
              finishes writing.
            </li>
            <li class="mb-2">
              <strong>Agent doesn't know the tools:</strong> Double-check that the MCP server
              connection is correctly configured in AIsuru and that the agent prompt mentions the
              available file operations.
            </li>
            <li class="mb-2">
              <strong>ngrok not starting:</strong> Make sure <code>NGROK_AUTHTOKEN</code> is set in
              <code>.env_dev</code> and the token is valid. Check logs with
              <code>docker compose logs ngrok</code>.
            </li>
            <li class="mb-2">
              <strong>Agent can't reach MCP server:</strong> The ngrok URL changes on every restart.
              Re-copy it from <code>docker compose logs ngrok</code> and update the MCP server
              endpoint in AIsuru.
            </li>
            <li class="mb-2">
              <strong>Rebuilding after code changes:</strong> If you modify <code>server.js</code>,
              stop and rebuild with <code>docker compose up --build mcp-server</code>.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <%# Explorer interactive JS %>
  <script>
    // Toggle open/close of a directory node
    function toggleDir(row) {
      var chevron = row.querySelector('.chevron');
      var children = row.nextElementSibling; // <ul class="node-children">
      if (!children) return;

      children.classList.toggle('hidden');
      chevron.classList.toggle('open');
    }

    // Show file content in the preview pane
    function previewFile(row, name, content) {
      // Highlight active row
      document.querySelectorAll('.explorer-tree .node-row').forEach(function(r) {
        r.classList.remove('active');
      });
      row.classList.add('active');

      // Update preview
      document.getElementById('explorer-preview-title').textContent = name;
      document.getElementById('explorer-preview-code').textContent = content;
    }

    // Refresh solo il tree senza ricaricare la pagina
    document.getElementById('explorer-refresh-btn').addEventListener('click', function() {
      var btn = this;
      btn.disabled = true;
      btn.innerHTML = '<i class="bi bi-arrow-repeat me-1 spin"></i> Refresh';

      fetch('<%= demo3_workspace_files_path %>')
        .then(function(response) { return response.text(); })
        .then(function(html) {
          document.getElementById('explorer-tree-container').innerHTML = html;
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Refresh';
        })
        .catch(function() {
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Refresh';
        });
    });
  </script>

  <style>
    .spin { animation: spin 0.6s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>

</div>
