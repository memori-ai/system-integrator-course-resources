<% content_for :title, "Demo 1: MongoDB via MCP Server" %>

<div class="container-fluid py-4">

  <%# Back to Home %>
  <div class="row mb-3">
    <div class="col">
      <%= link_to root_path, class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i> Back to Demo Selection
      <% end %>
    </div>
  </div>

  <% unless @show_agent %>
    <%# ============================================ %>
    <%# STEP 1: Setup Instructions + Configuration  %>
    <%# ============================================ %>

    <%# Hero Section %>
    <div class="row mb-4">
      <div class="col-lg-10 mx-auto text-center">
        <span class="badge bg-success mb-3 fs-6">Demo 1</span>
        <h1 class="display-5 fw-bold mb-3">
          <i class="bi bi-database me-2" style="color: #47A248;"></i>
          MongoDB via MCP Server
        </h1>
        <p class="lead text-muted">
          Connect an AIsuru agent to your local MongoDB database using the
          <strong>MCP (Model Context Protocol)</strong> integration.
          The agent will be able to read and modify data in real-time.
        </p>
      </div>
    </div>

    <%# Architecture Diagram %>
    <div class="row mb-4">
      <div class="col-lg-10 mx-auto">
        <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
          <div class="card-body text-center py-4">
            <h6 class="text-muted mb-3">Architecture</h6>
            <div class="d-flex justify-content-center align-items-center flex-wrap gap-2">
              <span class="badge bg-primary fs-6 px-3 py-2">AIsuru Agent</span>
              <i class="bi bi-arrow-right text-muted fs-4"></i>
              <span class="badge fs-6 px-3 py-2" style="background-color: #6f42c1;">MCP Server</span>
              <i class="bi bi-arrow-right text-muted fs-4"></i>
              <span class="badge bg-dark fs-6 px-3 py-2">ngrok TCP Tunnel</span>
              <i class="bi bi-arrow-right text-muted fs-4"></i>
              <span class="badge fs-6 px-3 py-2" style="background-color: #47A248;">MongoDB (Docker)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Setup Instructions %>
    <div class="row mb-4">
      <div class="col-lg-10 mx-auto">
        <div class="card border-success">
          <div class="card-header text-white" style="background-color: #47A248;">
            <h5 class="mb-0">
              <i class="bi bi-tools me-2"></i>
              Setup Instructions: MCP MongoDB Integration
            </h5>
          </div>
          <div class="card-body">
            <p class="text-muted mb-4">
              Follow these steps to connect your AIsuru agent to the local MongoDB database through the MCP server.
              The MCP MongoDB integration is already built into AIsuru &mdash; you just need to provide the connection details.
            </p>

            <%# Step 1 %>
            <div class="d-flex mb-4">
              <div class="flex-shrink-0 me-3">
                <span class="badge rounded-circle bg-success fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">1</span>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold">Start MongoDB with Docker Compose</h6>
                <p class="text-muted mb-2">
                  From the <code>demo/</code> directory, start the MongoDB container with authentication enabled:
                </p>
                <pre class="bg-dark text-light p-3 rounded mb-1"><code>docker compose up -d mongodb</code></pre>
                <small class="text-muted">
                  This starts a MongoDB 8.0 instance with seed data (products, customers, orders) in the <code>mcp_demo</code> database.
                </small>
              </div>
            </div>

            <%# Step 2 %>
            <div class="d-flex mb-4">
              <div class="flex-shrink-0 me-3">
                <span class="badge rounded-circle bg-success fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">2</span>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold">Expose MongoDB with ngrok TCP Tunnel</h6>
                <p class="text-muted mb-2">
                  Use ngrok to expose the local MongoDB port to the internet, so the AIsuru MCP server can reach it:
                </p>
                <pre class="bg-dark text-light p-3 rounded mb-1"><code>ngrok tcp 27017</code></pre>
                <small class="text-muted">
                  Copy the forwarding address (e.g. <code>tcp://X.tcp.ngrok.io:XXXXX</code>). You'll need the host and port.
                </small>
              </div>
            </div>

            <%# Step 3 %>
            <div class="d-flex mb-4">
              <div class="flex-shrink-0 me-3">
                <span class="badge rounded-circle bg-success fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">3</span>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold">Configure the MCP Integration in AIsuru</h6>
                <p class="text-muted mb-2">
                  In the AIsuru platform, open your agent settings and go to the <strong>Integrations</strong> section.
                  Add a new <strong>MCP Server</strong> integration with the following details:
                </p>
                <div class="table-responsive">
                  <table class="table table-bordered table-sm mb-2">
                    <tbody>
                      <tr>
                        <td class="fw-bold bg-light" style="width: 180px;">Connection String</td>
                        <td><code>mongodb://admin:adminpassword@<span class="text-danger">&lt;NGROK_HOST&gt;</span>:<span class="text-danger">&lt;NGROK_PORT&gt;</span>/mcp_demo?authSource=admin</code></td>
                      </tr>
                      <tr>
                        <td class="fw-bold bg-light">Database Name</td>
                        <td><code>mcp_demo</code></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <small class="text-muted">
                  Replace <code>&lt;NGROK_HOST&gt;</code> and <code>&lt;NGROK_PORT&gt;</code> with the values from your ngrok output.
                  For example: <code>mongodb://admin:adminpassword@8.tcp.ngrok.io:12811/mcp_demo?authSource=admin</code>
                </small>
              </div>
            </div>

            <%# Step 4 %>
            <div class="d-flex mb-3">
              <div class="flex-shrink-0 me-3">
                <span class="badge rounded-circle bg-success fs-5 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">4</span>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold">Load the Agent Below &amp; Start Chatting</h6>
                <p class="text-muted mb-0">
                  Enter your agent's credentials in the form below and click <strong>"Load Agent"</strong>.
                  The agent will be able to query and modify the MongoDB database via MCP.
                  Use the <strong>DB Explorer</strong> panel on the right to see changes in real-time.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Info about how to get Agent IDs %>
    <div class="row mb-4">
      <div class="col-lg-10 mx-auto">
        <div class="card border-info">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0">
              <i class="bi bi-info-circle me-2"></i>
              How to get your Agent IDs
            </h5>
          </div>
          <div class="card-body">
            <ol class="mb-0">
              <li class="mb-2">
                <strong>Create an Agent</strong> on <a href="https://www.aisuru.com" target="_blank">AIsuru</a>
                (or use your own tenant if you have a PaaS subscription)
              </li>
              <li class="mb-2">
                <strong>Open your Agent</strong> and click on <strong>"Dev docs"</strong> in the left sidebar
              </li>
              <li class="mb-2">
                Expand the <strong>"Other references"</strong> section (or "Altri riferimenti" in Italian)
              </li>
              <li class="mb-2">
                Copy the following values:
                <ul class="mt-2">
                  <li><strong>Secondary Memori (Agent) ID</strong> &rarr; This is your <code>memoriID</code></li>
                  <li><strong>Owner user ID</strong> &rarr; This is your <code>ownerUserID</code></li>
                </ul>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <%# Configuration Form %>
    <div class="row mb-5">
      <div class="col-lg-8 mx-auto">
        <div class="card shadow">
          <div class="card-header text-white" style="background-color: #47A248;">
            <h5 class="mb-0">
              <i class="bi bi-gear me-2"></i>
              Configure Your Agent
            </h5>
          </div>
          <div class="card-body p-4">
            <%= form_with url: demo1_configure_path, method: :post, local: true do |f| %>
              <div class="mb-4">
                <label for="memori_id" class="form-label fw-bold">
                  <i class="bi bi-fingerprint me-1"></i>
                  Memori ID (Secondary Agent ID)
                </label>
                <%= f.text_field :memori_id,
                    class: "form-control form-control-lg",
                    placeholder: "e.g., a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    required: true,
                    pattern: "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" %>
                <div class="form-text">
                  Found in Dev docs &rarr; Other references &rarr; "Secondary Memori (Agent) ID"
                </div>
              </div>

              <div class="mb-4">
                <label for="owner_user_id" class="form-label fw-bold">
                  <i class="bi bi-person-badge me-1"></i>
                  Owner User ID
                </label>
                <%= f.text_field :owner_user_id,
                    class: "form-control form-control-lg",
                    placeholder: "e.g., b2c3d4e5-f6a7-8901-bcde-f12345678901",
                    required: true,
                    pattern: "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" %>
                <div class="form-text">
                  Found in Dev docs &rarr; Other references &rarr; "Owner user ID"
                </div>
              </div>

              <hr class="my-4">
              <h6 class="text-muted mb-3">
                <i class="bi bi-sliders me-1"></i>
                Advanced Configuration (pre-filled with defaults)
              </h6>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="tenant_id" class="form-label">
                    <i class="bi bi-building me-1"></i>
                    Tenant ID
                  </label>
                  <%= f.text_field :tenant_id,
                      class: "form-control",
                      value: @tenant_id || "www.aisuru.com",
                      required: true %>
                </div>

                <div class="col-md-6 mb-3">
                  <label for="base_url" class="form-label">
                    <i class="bi bi-link-45deg me-1"></i>
                    Base URL
                  </label>
                  <%= f.text_field :base_url,
                      class: "form-control",
                      value: @base_url || "https://www.aisuru.com",
                      required: true %>
                </div>
              </div>

              <div class="mb-3">
                <label for="engine_url" class="form-label">
                  <i class="bi bi-cpu me-1"></i>
                  Engine URL
                </label>
                <%= f.text_field :engine_url,
                    class: "form-control",
                    value: @engine_url || "https://engine.memori.ai/memori/v2",
                    required: true %>
              </div>

              <div class="mb-4">
                <label for="api_url" class="form-label">
                  <i class="bi bi-server me-1"></i>
                  API URL
                </label>
                <%= f.text_field :api_url,
                    class: "form-control",
                    value: @api_url || "https://backend.memori.ai/api/v2",
                    required: true %>
              </div>

              <div class="d-grid">
                <%= f.submit "Load Agent", class: "btn btn-lg text-white", style: "background-color: #47A248;" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# What you'll see %>
    <div class="row mb-5">
      <div class="col-lg-10 mx-auto">
        <div class="row g-4">
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body text-center p-4">
                <i class="bi bi-robot display-4 text-primary mb-3"></i>
                <h5 class="card-title">Chat with the Agent</h5>
                <p class="card-text text-muted">
                  Ask the agent to query products, look up customers, check order status, or even modify data.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body text-center p-4">
                <i class="bi bi-database-gear display-4 mb-3" style="color: #47A248;"></i>
                <h5 class="card-title">Live DB Explorer</h5>
                <p class="card-text text-muted">
                  See the MongoDB data update in real-time as the agent performs operations through MCP.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body text-center p-4">
                <i class="bi bi-diagram-3 display-4" style="color: #6f42c1;"></i>
                <h5 class="card-title">MCP Protocol</h5>
                <p class="card-text text-muted">
                  The Model Context Protocol enables secure, structured communication between AI agents and external tools.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  <% else %>
    <%# ============================================ %>
    <%# STEP 2: Agent + DB Explorer (Two-Column)    %>
    <%# ============================================ %>

    <%# Agent Info Banner %>
    <div class="row mb-3">
      <div class="col-12">
        <div class="alert alert-success d-flex align-items-center mb-0">
          <i class="bi bi-check-circle-fill me-2 fs-5"></i>
          <div class="flex-grow-1">
            <strong>Agent Connected!</strong>
            Chat with the agent on the left &mdash; it can read and modify the MongoDB database via MCP.
            Click <strong>"Refresh Data"</strong> on the right to see live changes.
          </div>
          <%= link_to demo1_path, class: "btn btn-outline-success btn-sm ms-3" do %>
            <i class="bi bi-arrow-counterclockwise me-1"></i> Reconfigure
          <% end %>
        </div>
      </div>
    </div>

    <%# Two-Column Layout %>
    <div class="row g-3">

      <%# LEFT: Agent %>
      <div class="col-lg-6">
        <div class="card shadow h-100">
          <div class="card-header text-white d-flex align-items-center" style="background-color: #47A248;">
            <i class="bi bi-robot me-2"></i>
            <strong>AIsuru Agent</strong>
            <span class="badge bg-light text-dark ms-auto">MCP-enabled</span>
          </div>
          <div class="card-body p-0">
            <div class="memori-container" style="height: 650px;">
              <memori-client
                memoriName="YourAgent"
                ownerUserName="owner"
                memoriID="<%= @memori_id %>"
                ownerUserID="<%= @owner_user_id %>"
                tenantID="<%= @tenant_id %>"
                engineURL="<%= @engine_url %>"
                apiURL="<%= @api_url %>"
                baseURL="<%= @base_url %>"
                layout="CHAT"
                uiLang="EN"
                spokenLang="EN"
                showLogin="true"
              ></memori-client>
            </div>
          </div>
        </div>
      </div>

      <%# RIGHT: DB Explorer %>
      <div class="col-lg-6">
        <div class="card shadow h-100">
          <div class="card-header bg-dark text-white d-flex align-items-center">
            <i class="bi bi-database me-2"></i>
            <strong>MongoDB Explorer</strong>
            <span class="badge bg-secondary ms-2">mcp_demo</span>
            <button class="btn btn-sm btn-outline-light ms-auto" id="btn-refresh-db" onclick="refreshDbData()">
              <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
            </button>
          </div>
          <div class="card-body p-0" style="height: 650px; overflow-y: auto;" id="db-explorer-body">

            <%# Initial state %>
            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" id="db-placeholder">
              <i class="bi bi-database-gear display-1 mb-3" style="color: #47A248; opacity: 0.5;"></i>
              <h5>MongoDB Data Explorer</h5>
              <p class="text-center px-4">
                Click <strong>"Refresh Data"</strong> to load the current state of the <code>mcp_demo</code> database.<br>
                After chatting with the agent, refresh again to see the changes.
              </p>
              <button class="btn text-white" style="background-color: #47A248;" onclick="refreshDbData()">
                <i class="bi bi-arrow-clockwise me-1"></i> Load Database
              </button>
            </div>

            <%# Data container (hidden initially) %>
            <div class="d-none p-3" id="db-data-container">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <small class="text-muted" id="db-timestamp"></small>
                <span class="badge bg-success" id="db-status-badge">Connected</span>
              </div>

              <%# Tabs for collections %>
              <ul class="nav nav-tabs" role="tablist" id="collection-tabs">
                <li class="nav-item" role="presentation">
                  <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-products" type="button" role="tab">
                    <i class="bi bi-box-seam me-1"></i> Products
                    <span class="badge bg-secondary ms-1" id="count-products">0</span>
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-customers" type="button" role="tab">
                    <i class="bi bi-people me-1"></i> Customers
                    <span class="badge bg-secondary ms-1" id="count-customers">0</span>
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-orders" type="button" role="tab">
                    <i class="bi bi-cart me-1"></i> Orders
                    <span class="badge bg-secondary ms-1" id="count-orders">0</span>
                  </button>
                </li>
              </ul>

              <div class="tab-content mt-2" id="collection-tab-content">
                <%# Products tab %>
                <div class="tab-pane fade show active" id="tab-products" role="tabpanel">
                  <div id="table-products"></div>
                </div>
                <%# Customers tab %>
                <div class="tab-pane fade" id="tab-customers" role="tabpanel">
                  <div id="table-customers"></div>
                </div>
                <%# Orders tab %>
                <div class="tab-pane fade" id="tab-orders" role="tabpanel">
                  <div id="table-orders"></div>
                </div>
              </div>
            </div>

            <%# Error state %>
            <div class="d-none d-flex flex-column align-items-center justify-content-center h-100" id="db-error-container">
              <i class="bi bi-exclamation-triangle display-1 text-danger mb-3"></i>
              <h5 class="text-danger">Connection Error</h5>
              <p class="text-muted text-center px-4" id="db-error-message"></p>
              <button class="btn btn-outline-danger" onclick="refreshDbData()">
                <i class="bi bi-arrow-clockwise me-1"></i> Retry
              </button>
            </div>

          </div>
        </div>
      </div>
    </div>

    <%# Config summary (collapsible) %>
    <div class="row mt-3">
      <div class="col-12">
        <div class="accordion" id="configAccordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#configDetails">
                <i class="bi bi-code me-2"></i>
                <small>Current Configuration</small>
              </button>
            </h2>
            <div id="configDetails" class="accordion-collapse collapse" data-bs-parent="#configAccordion">
              <div class="accordion-body py-2">
                <div class="row">
                  <div class="col-md-3"><small class="text-muted">Memori ID:</small><br><small class="font-monospace"><%= @memori_id %></small></div>
                  <div class="col-md-3"><small class="text-muted">Owner User ID:</small><br><small class="font-monospace"><%= @owner_user_id %></small></div>
                  <div class="col-md-3"><small class="text-muted">Tenant ID:</small><br><small class="font-monospace"><%= @tenant_id %></small></div>
                  <div class="col-md-3"><small class="text-muted">Engine URL:</small><br><small class="font-monospace"><%= @engine_url %></small></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      function refreshDbData() {
        const btn = document.getElementById('btn-refresh-db');
        const placeholder = document.getElementById('db-placeholder');
        const dataContainer = document.getElementById('db-data-container');
        const errorContainer = document.getElementById('db-error-container');

        // Disable button and show spinner
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Loading...';

        fetch('<%= demo1_db_status_path %>')
          .then(response => {
            if (!response.ok) throw new Error('Failed to connect to MongoDB');
            return response.json();
          })
          .then(data => {
            if (data.error) throw new Error(data.error);

            // Hide placeholder and error, show data
            placeholder.classList.add('d-none');
            errorContainer.classList.add('d-none');
            dataContainer.classList.remove('d-none');

            // Update timestamp
            const ts = new Date(data.timestamp);
            document.getElementById('db-timestamp').textContent =
              'Last refreshed: ' + ts.toLocaleTimeString();

            // Update counts
            document.getElementById('count-products').textContent = data.collections.products.count;
            document.getElementById('count-customers').textContent = data.collections.customers.count;
            document.getElementById('count-orders').textContent = data.collections.orders.count;

            // Render tables
            renderProductsTable(data.collections.products.documents);
            renderCustomersTable(data.collections.customers.documents);
            renderOrdersTable(data.collections.orders.documents);
          })
          .catch(error => {
            placeholder.classList.add('d-none');
            dataContainer.classList.add('d-none');
            errorContainer.classList.remove('d-none');
            document.getElementById('db-error-message').textContent = error.message;
          })
          .finally(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Refresh Data';
          });
      }

      function renderProductsTable(docs) {
        if (!docs.length) {
          document.getElementById('table-products').innerHTML =
            '<p class="text-muted p-3">No products found.</p>';
          return;
        }
        let html = '<div class="table-responsive"><table class="table table-sm table-striped table-hover mb-0">';
        html += '<thead class="table-light"><tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Tags</th></tr></thead><tbody>';
        docs.forEach(doc => {
          const tags = (doc.tags || []).map(t => '<span class="badge bg-light text-dark border me-1">' + t + '</span>').join('');
          html += '<tr>';
          html += '<td class="fw-semibold">' + escHtml(doc.name || '') + '</td>';
          html += '<td>' + escHtml(doc.category || '') + '</td>';
          html += '<td>$' + (doc.price || 0).toFixed(2) + '</td>';
          html += '<td>' + (doc.stock || 0) + '</td>';
          html += '<td>' + tags + '</td>';
          html += '</tr>';
        });
        html += '</tbody></table></div>';
        document.getElementById('table-products').innerHTML = html;
      }

      function renderCustomersTable(docs) {
        if (!docs.length) {
          document.getElementById('table-customers').innerHTML =
            '<p class="text-muted p-3">No customers found.</p>';
          return;
        }
        let html = '<div class="table-responsive"><table class="table table-sm table-striped table-hover mb-0">';
        html += '<thead class="table-light"><tr><th>Name</th><th>Email</th><th>City</th><th>Tier</th><th>Orders</th><th>Spent</th></tr></thead><tbody>';
        docs.forEach(doc => {
          const tierClass = { 'Platinum': 'bg-dark', 'Gold': 'bg-warning text-dark', 'Silver': 'bg-secondary', 'Bronze': 'bg-danger' }[doc.tier] || 'bg-light text-dark';
          html += '<tr>';
          html += '<td class="fw-semibold">' + escHtml((doc.firstName || '') + ' ' + (doc.lastName || '')) + '</td>';
          html += '<td><small>' + escHtml(doc.email || '') + '</small></td>';
          html += '<td>' + escHtml(doc.city || '') + '</td>';
          html += '<td><span class="badge ' + tierClass + '">' + escHtml(doc.tier || '') + '</span></td>';
          html += '<td>' + (doc.totalOrders || 0) + '</td>';
          html += '<td>$' + (doc.totalSpent || 0).toFixed(2) + '</td>';
          html += '</tr>';
        });
        html += '</tbody></table></div>';
        document.getElementById('table-customers').innerHTML = html;
      }

      function renderOrdersTable(docs) {
        if (!docs.length) {
          document.getElementById('table-orders').innerHTML =
            '<p class="text-muted p-3">No orders found.</p>';
          return;
        }
        let html = '<div class="table-responsive"><table class="table table-sm table-striped table-hover mb-0">';
        html += '<thead class="table-light"><tr><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody>';
        docs.forEach(doc => {
          const statusClass = { 'delivered': 'bg-success', 'shipped': 'bg-info', 'processing': 'bg-warning text-dark', 'cancelled': 'bg-danger' }[doc.status] || 'bg-secondary';
          const items = (doc.items || []).map(i => i.product + ' x' + i.quantity).join(', ');
          const orderDate = doc.orderDate ? new Date(doc.orderDate).toLocaleDateString() : '';
          html += '<tr>';
          html += '<td><small>' + escHtml(doc.customerEmail || '') + '</small></td>';
          html += '<td><small>' + escHtml(items) + '</small></td>';
          html += '<td class="fw-semibold">$' + (doc.total || 0).toFixed(2) + '</td>';
          html += '<td><span class="badge ' + statusClass + '">' + escHtml(doc.status || '') + '</span></td>';
          html += '<td><small>' + orderDate + '</small></td>';
          html += '</tr>';
        });
        html += '</tbody></table></div>';
        document.getElementById('table-orders').innerHTML = html;
      }

      function escHtml(str) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
      }
    </script>

  <% end %>
</div>
