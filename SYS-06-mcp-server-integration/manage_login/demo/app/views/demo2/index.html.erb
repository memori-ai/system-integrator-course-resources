<% content_for :title, "Demo 2: MySQL via MCP Server" %>

<div class="container-fluid py-4">

  <%# Back to Home %>
  <div class="row mb-3">
    <div class="col">
      <%= link_to root_path, class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i> Back to Demo Selection
      <% end %>
    </div>
  </div>

  <% unless @show_agent %>
    <%# ============================================ %>
    <%# STEP 1: Setup Instructions + Configuration  %>
    <%# ============================================ %>

    <%# Hero Section %>
    <div class="row mb-4">
      <div class="col-lg-10 mx-auto text-center">
        <span class="badge mb-3 fs-6 text-white" style="background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">Demo 2</span>
        <h1 class="display-5 fw-bold mb-3">
          <i class="bi bi-database-fill-gear me-2" style="color: #e85d04;"></i>
          MySQL via MCP Server
        </h1>
        <p class="lead text-muted">
          Connect an AIsuru agent to your local MySQL database using a
          <strong>self-hosted MCP server</strong> deployed from npm.
          The agent will be able to query and modify data in real-time.
        </p>
      </div>
    </div>

    <%# Architecture Diagram %>
    <div class="row mb-4">
      <div class="col-lg-10 mx-auto">
        <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
          <div class="card-body text-center py-4">
            <h6 class="text-muted mb-3">Architecture</h6>
            <div class="d-flex justify-content-center align-items-center flex-wrap gap-2">
              <span class="badge bg-primary fs-6 px-3 py-2">AIsuru Agent</span>
              <i class="bi bi-arrow-right text-muted fs-4"></i>
              <span class="badge bg-dark fs-6 px-3 py-2">ngrok HTTPS</span>
              <i class="bi bi-arrow-right text-muted fs-4"></i>
              <span class="badge fs-6 px-3 py-2 text-white" style="background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">MCP Server (npm)</span>
              <i class="bi bi-arrow-right text-muted fs-4"></i>
              <span class="badge fs-6 px-3 py-2" style="background-color: #00618a; color: white;">MySQL (Docker)</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Setup Instructions %>
    <div class="row mb-4">
      <div class="col-lg-10 mx-auto">
        <div class="card border-danger">
          <div class="card-header text-white" style="background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">
            <h5 class="mb-0">
              <i class="bi bi-tools me-2"></i>
              Setup Instructions: MySQL MCP Server
            </h5>
          </div>
          <div class="card-body">
            <p class="text-muted mb-4">
              Follow these steps to connect your AIsuru agent to the local MySQL database through a self-hosted MCP server.
              The MCP server is deployed from an npm package and runs in a Docker container.
            </p>

            <%# Step 1 %>
            <div class="d-flex mb-4">
              <div class="flex-shrink-0 me-3">
                <span class="badge rounded-circle fs-5 d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px; background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">1</span>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold">Free ngrok Tunnel (if needed)</h6>
                <p class="text-muted mb-2">
                  <strong>⚠️ ngrok free accounts support only 1 active tunnel.</strong> If you were using another demo, stop all ngrok tunnels first:
                </p>
                <pre class="bg-dark text-light p-3 rounded mb-1"><code>docker compose stop ngrok-mcp ngrok-mcp-mysql</code></pre>
                <small class="text-muted">
                  This stops all ngrok tunnels, freeing the connection for this demo.
                </small>
              </div>
            </div>

            <%# Step 2 %>
            <div class="d-flex mb-4">
              <div class="flex-shrink-0 me-3">
                <span class="badge rounded-circle fs-5 d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px; background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">2</span>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold">Start the MCP Server for MySQL</h6>
                <p class="text-muted mb-2">
                  Start the ngrok tunnel for the MySQL MCP server (Demo 2):
                </p>
                <pre class="bg-dark text-light p-3 rounded mb-1"><code>docker compose up -d ngrok-mcp-mysql</code></pre>
                <small class="text-muted">
                  Access the ngrok dashboard at <a href="http://localhost:4042" target="_blank" class="text-decoration-none">http://localhost:4042</a> to see the public HTTPS URL.
                </small>
              </div>
            </div>

            <%# Step 3 %>
            <div class="d-flex mb-4">
              <div class="flex-shrink-0 me-3">
                <span class="badge rounded-circle fs-5 d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px; background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">3</span>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold">Get the ngrok HTTPS URL</h6>
                <p class="text-muted mb-2">
                  Open the ngrok dashboard at <a href="http://localhost:4042" target="_blank" class="text-decoration-none">http://localhost:4042</a> and copy the <strong>HTTPS URL</strong> (e.g., <code>https://abc123.ngrok-free.dev</code>).
                </p>
                <small class="text-muted">
                  You'll use this URL with the <code>/mcp</code> endpoint to configure the MCP server in AIsuru.
                </small>
              </div>
            </div>

            <%# Step 4 %>
            <div class="d-flex mb-4">
              <div class="flex-shrink-0 me-3">
                <span class="badge rounded-circle fs-5 d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px; background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">4</span>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold">Configure the MCP Server in AIsuru</h6>
                <p class="text-muted mb-2">
                  In AIsuru, add the MCP server using the HTTPS URL from ngrok with <code>/mcp</code> endpoint:
                </p>
                <pre class="bg-dark text-light p-3 rounded mb-1"><code>https://your-ngrok-url.ngrok-free.dev/mcp</code></pre>
                <small class="text-muted">
                  The MCP server exposes MySQL database tools: <code>query</code> (SELECT), <code>execute</code> (INSERT/UPDATE/DELETE), <code>list_tables</code>, and <code>describe_table</code>.
                </small>
              </div>
            </div>

            <%# Step 5 %>
            <div class="d-flex mb-3">
              <div class="flex-shrink-0 me-3">
                <span class="badge rounded-circle fs-5 d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px; background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">5</span>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold">Load the Agent Below &amp; Start Chatting</h6>
                <p class="text-muted mb-0">
                  Enter your agent's credentials in the form below and click <strong>"Load Agent"</strong>.
                  The agent will be able to query and modify the MySQL database via MCP.
                  Use the <strong>DB Explorer</strong> panel on the right to see changes in real-time.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Info about how to get Agent IDs %>
    <div class="row mb-4">
      <div class="col-lg-10 mx-auto">
        <div class="card border-info">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0">
              <i class="bi bi-info-circle me-2"></i>
              How to get your Agent IDs
            </h5>
          </div>
          <div class="card-body">
            <ol class="mb-0">
              <li class="mb-2">
                <strong>Create an Agent</strong> on <a href="https://www.aisuru.com" target="_blank">AIsuru</a>
                (or use your own tenant if you have a PaaS subscription)
              </li>
              <li class="mb-2">
                <strong>Open your Agent</strong> and click on <strong>"Dev docs"</strong> in the left sidebar
              </li>
              <li class="mb-2">
                Expand the <strong>"Other references"</strong> section (or "Altri riferimenti" in Italian)
              </li>
              <li class="mb-2">
                Copy the following values:
                <ul class="mt-2">
                  <li><strong>Secondary Memori (Agent) ID</strong> &rarr; This is your <code>memoriID</code></li>
                  <li><strong>Owner user ID</strong> &rarr; This is your <code>ownerUserID</code></li>
                </ul>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </div>

    <%# Configuration Form %>
    <div class="row mb-5">
      <div class="col-lg-8 mx-auto">
        <div class="card shadow">
          <div class="card-header text-white" style="background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">
            <h5 class="mb-0">
              <i class="bi bi-gear me-2"></i>
              Configure Your Agent
            </h5>
          </div>
          <div class="card-body p-4">
            <%= form_with url: demo2_configure_path, method: :post, local: true do |f| %>
              <div class="mb-4">
                <label for="memori_id" class="form-label fw-bold">
                  <i class="bi bi-fingerprint me-1"></i>
                  Memori ID (Secondary Agent ID)
                </label>
                <%= f.text_field :memori_id,
                    class: "form-control form-control-lg",
                    placeholder: "e.g., a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                    required: true,
                    pattern: "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" %>
                <div class="form-text">
                  Found in Dev docs &rarr; Other references &rarr; "Secondary Memori (Agent) ID"
                </div>
              </div>

              <div class="mb-4">
                <label for="owner_user_id" class="form-label fw-bold">
                  <i class="bi bi-person-badge me-1"></i>
                  Owner User ID
                </label>
                <%= f.text_field :owner_user_id,
                    class: "form-control form-control-lg",
                    placeholder: "e.g., b2c3d4e5-f6a7-8901-bcde-f12345678901",
                    required: true,
                    pattern: "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" %>
                <div class="form-text">
                  Found in Dev docs &rarr; Other references &rarr; "Owner user ID"
                </div>
              </div>

              <hr class="my-4">
              <h6 class="text-muted mb-3">
                <i class="bi bi-sliders me-1"></i>
                Advanced Configuration (pre-filled with defaults)
              </h6>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="tenant_id" class="form-label">
                    <i class="bi bi-building me-1"></i>
                    Tenant ID
                  </label>
                  <%= f.text_field :tenant_id,
                      class: "form-control",
                      value: @tenant_id || "www.aisuru.com",
                      required: true %>
                </div>

                <div class="col-md-6 mb-3">
                  <label for="base_url" class="form-label">
                    <i class="bi bi-link-45deg me-1"></i>
                    Base URL
                  </label>
                  <%= f.text_field :base_url,
                      class: "form-control",
                      value: @base_url || "https://www.aisuru.com",
                      required: true %>
                </div>
              </div>

              <div class="mb-3">
                <label for="engine_url" class="form-label">
                  <i class="bi bi-cpu me-1"></i>
                  Engine URL
                </label>
                <%= f.text_field :engine_url,
                    class: "form-control",
                    value: @engine_url || "https://engine.memori.ai/memori/v2",
                    required: true %>
              </div>

              <div class="mb-4">
                <label for="api_url" class="form-label">
                  <i class="bi bi-server me-1"></i>
                  API URL
                </label>
                <%= f.text_field :api_url,
                    class: "form-control",
                    value: @api_url || "https://backend.memori.ai/api/v2",
                    required: true %>
              </div>

              <div class="d-grid">
                <%= f.submit "Load Agent", class: "btn btn-lg text-white", style: "background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# What you'll see %>
    <div class="row mb-5">
      <div class="col-lg-10 mx-auto">
        <div class="row g-4">
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body text-center p-4">
                <i class="bi bi-robot display-4 text-primary mb-3"></i>
                <h5 class="card-title">Chat with the Agent</h5>
                <p class="card-text text-muted">
                  Ask the agent to query users, look up products, check orders, or even modify data.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body text-center p-4">
                <i class="bi bi-database-gear display-4 mb-3" style="color: #e85d04;"></i>
                <h5 class="card-title">Live DB Explorer</h5>
                <p class="card-text text-muted">
                  See the MySQL data update in real-time as the agent performs operations through MCP.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body text-center p-4">
                <i class="bi bi-box-seam display-4" style="color: #f48c06;"></i>
                <h5 class="card-title">Self-Hosted MCP</h5>
                <p class="card-text text-muted">
                  The MCP server runs from an npm package, giving you full control over database operations.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  <% else %>
    <%# ============================================ %>
    <%# STEP 2: Agent + DB Explorer (Two-Column)    %>
    <%# ============================================ %>

    <%# Agent Info Banner %>
    <div class="row mb-3">
      <div class="col-12">
        <div class="alert d-flex align-items-center mb-0 text-white" style="background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">
          <i class="bi bi-check-circle-fill me-2 fs-5"></i>
          <div class="flex-grow-1">
            <strong>Agent Connected!</strong>
            Chat with the agent on the left &mdash; it can read and modify the MySQL database via MCP.
            Click <strong>"Refresh Data"</strong> on the right to see live changes.
          </div>
          <%= link_to demo2_path, class: "btn btn-outline-light btn-sm ms-3" do %>
            <i class="bi bi-arrow-counterclockwise me-1"></i> Reconfigure
          <% end %>
        </div>
      </div>
    </div>

    <%# Two-Column Layout %>
    <div class="row g-3">

      <%# LEFT: Agent %>
      <div class="col-lg-6">
        <div class="card shadow h-100">
          <div class="card-header text-white d-flex align-items-center" style="background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);">
            <i class="bi bi-robot me-2"></i>
            <strong>AIsuru Agent</strong>
            <span class="badge bg-light text-dark ms-auto">MCP-enabled</span>
          </div>
          <div class="card-body p-0">
            <div class="memori-container" style="height: 650px;">
              <memori-client
                memoriName="YourAgent"
                ownerUserName="owner"
                memoriID="<%= @memori_id %>"
                ownerUserID="<%= @owner_user_id %>"
                tenantID="<%= @tenant_id %>"
                engineURL="<%= @engine_url %>"
                apiURL="<%= @api_url %>"
                baseURL="<%= @base_url %>"
                layout="CHAT"
                uiLang="EN"
                spokenLang="EN"
                showLogin="true"
              ></memori-client>
            </div>
          </div>
        </div>
      </div>

      <%# RIGHT: DB Explorer %>
      <div class="col-lg-6">
        <div class="card shadow h-100">
          <div class="card-header text-white d-flex align-items-center" style="background-color: #00618a;">
            <i class="bi bi-database me-2"></i>
            <strong>MySQL Explorer</strong>
            <span class="badge bg-light text-dark ms-2">mcp_demo_mysql</span>
            <button class="btn btn-sm btn-outline-light ms-auto" id="btn-refresh-db" onclick="refreshDbData()">
              <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
            </button>
          </div>
          <div class="card-body p-0" style="height: 650px; overflow-y: auto;" id="db-explorer-body">

            <%# Initial state %>
            <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" id="db-placeholder">
              <i class="bi bi-database-gear display-1 mb-3" style="color: #e85d04; opacity: 0.5;"></i>
              <h5>MySQL Data Explorer</h5>
              <p class="text-center px-4">
                Click <strong>"Refresh Data"</strong> to load the current state of the <code>mcp_demo_mysql</code> database.<br>
                After chatting with the agent, refresh again to see the changes.
              </p>
              <button class="btn text-white" style="background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);" onclick="refreshDbData()">
                <i class="bi bi-arrow-clockwise me-1"></i> Load Database
              </button>
            </div>

            <%# Data container (hidden initially) %>
            <div class="d-none p-3" id="db-data-container">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <small class="text-muted" id="db-timestamp"></small>
                <span class="badge text-white" style="background: linear-gradient(135deg, #e85d04 0%, #f48c06 100%);" id="db-status-badge">Connected</span>
              </div>

              <%# Tabs for tables %>
              <ul class="nav nav-tabs" role="tablist" id="table-tabs">
                <li class="nav-item" role="presentation">
                  <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-users" type="button" role="tab">
                    <i class="bi bi-people me-1"></i> Users
                    <span class="badge bg-secondary ms-1" id="count-users">0</span>
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-products" type="button" role="tab">
                    <i class="bi bi-box-seam me-1"></i> Products
                    <span class="badge bg-secondary ms-1" id="count-products">0</span>
                  </button>
                </li>
                <li class="nav-item" role="presentation">
                  <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-orders" type="button" role="tab">
                    <i class="bi bi-cart me-1"></i> Orders
                    <span class="badge bg-secondary ms-1" id="count-orders">0</span>
                  </button>
                </li>
              </ul>

              <div class="tab-content mt-2" id="table-tab-content">
                <%# Users tab %>
                <div class="tab-pane fade show active" id="tab-users" role="tabpanel">
                  <div id="table-users"></div>
                </div>
                <%# Products tab %>
                <div class="tab-pane fade" id="tab-products" role="tabpanel">
                  <div id="table-products"></div>
                </div>
                <%# Orders tab %>
                <div class="tab-pane fade" id="tab-orders" role="tabpanel">
                  <div id="table-orders"></div>
                </div>
              </div>
            </div>

            <%# Error state %>
            <div class="d-none d-flex flex-column align-items-center justify-content-center h-100" id="db-error-container">
              <i class="bi bi-exclamation-triangle display-1 text-danger mb-3"></i>
              <h5 class="text-danger">Connection Error</h5>
              <p class="text-muted text-center px-4" id="db-error-message"></p>
              <button class="btn btn-outline-danger" onclick="refreshDbData()">
                <i class="bi bi-arrow-clockwise me-1"></i> Retry
              </button>
            </div>

          </div>
        </div>
      </div>
    </div>

    <%# Config summary (collapsible) %>
    <div class="row mt-3">
      <div class="col-12">
        <div class="accordion" id="configAccordion">
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#configDetails">
                <i class="bi bi-code me-2"></i>
                <small>Current Configuration</small>
              </button>
            </h2>
            <div id="configDetails" class="accordion-collapse collapse" data-bs-parent="#configAccordion">
              <div class="accordion-body py-2">
                <div class="row">
                  <div class="col-md-3"><small class="text-muted">Memori ID:</small><br><small class="font-monospace"><%= @memori_id %></small></div>
                  <div class="col-md-3"><small class="text-muted">Owner User ID:</small><br><small class="font-monospace"><%= @owner_user_id %></small></div>
                  <div class="col-md-3"><small class="text-muted">Tenant ID:</small><br><small class="font-monospace"><%= @tenant_id %></small></div>
                  <div class="col-md-3"><small class="text-muted">Engine URL:</small><br><small class="font-monospace"><%= @engine_url %></small></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      function refreshDbData() {
        const btn = document.getElementById('btn-refresh-db');
        const placeholder = document.getElementById('db-placeholder');
        const dataContainer = document.getElementById('db-data-container');
        const errorContainer = document.getElementById('db-error-container');

        // Disable button and show spinner
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Loading...';

        fetch('<%= demo2_db_status_path %>')
          .then(response => {
            if (!response.ok) throw new Error('Failed to connect to MySQL');
            return response.json();
          })
          .then(data => {
            if (data.error) throw new Error(data.error);

            // Hide placeholder and error, show data
            placeholder.classList.add('d-none');
            errorContainer.classList.add('d-none');
            dataContainer.classList.remove('d-none');

            // Update timestamp
            const ts = new Date(data.timestamp);
            document.getElementById('db-timestamp').textContent =
              'Last refreshed: ' + ts.toLocaleTimeString();

            // Update counts
            document.getElementById('count-users').textContent = data.tables.users.count;
            document.getElementById('count-products').textContent = data.tables.products.count;
            document.getElementById('count-orders').textContent = data.tables.orders.count;

            // Render tables
            renderUsersTable(data.tables.users.records);
            renderProductsTable(data.tables.products.records);
            renderOrdersTable(data.tables.orders.records);
          })
          .catch(error => {
            placeholder.classList.add('d-none');
            dataContainer.classList.add('d-none');
            errorContainer.classList.remove('d-none');
            document.getElementById('db-error-message').textContent = error.message;
          })
          .finally(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> Refresh Data';
          });
      }

      function renderUsersTable(records) {
        if (!records.length) {
          document.getElementById('table-users').innerHTML =
            '<p class="text-muted p-3">No users found.</p>';
          return;
        }
        let html = '<div class="table-responsive"><table class="table table-sm table-striped table-hover mb-0">';
        html += '<thead class="table-light"><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Created</th></tr></thead><tbody>';
        records.forEach(record => {
          const roleClass = { 'admin': 'bg-danger', 'moderator': 'bg-warning text-dark', 'user': 'bg-secondary' }[record.role] || 'bg-light text-dark';
          const createdAt = record.created_at ? new Date(record.created_at).toLocaleDateString() : '';
          html += '<tr>';
          html += '<td><small class="text-muted">#' + record.id + '</small></td>';
          html += '<td class="fw-semibold">' + escHtml(record.name || '') + '</td>';
          html += '<td><small>' + escHtml(record.email || '') + '</small></td>';
          html += '<td><span class="badge ' + roleClass + '">' + escHtml(record.role || '') + '</span></td>';
          html += '<td><small>' + createdAt + '</small></td>';
          html += '</tr>';
        });
        html += '</tbody></table></div>';
        document.getElementById('table-users').innerHTML = html;
      }

      function renderProductsTable(records) {
        if (!records.length) {
          document.getElementById('table-products').innerHTML =
            '<p class="text-muted p-3">No products found.</p>';
          return;
        }
        let html = '<div class="table-responsive"><table class="table table-sm table-striped table-hover mb-0">';
        html += '<thead class="table-light"><tr><th>ID</th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th></tr></thead><tbody>';
        records.forEach(record => {
          html += '<tr>';
          html += '<td><small class="text-muted">#' + record.id + '</small></td>';
          html += '<td class="fw-semibold">' + escHtml(record.name || '') + '</td>';
          html += '<td>' + escHtml(record.category || '') + '</td>';
          html += '<td>$' + parseFloat(record.price || 0).toFixed(2) + '</td>';
          html += '<td>' + (record.stock || 0) + '</td>';
          html += '</tr>';
        });
        html += '</tbody></table></div>';
        document.getElementById('table-products').innerHTML = html;
      }

      function renderOrdersTable(records) {
        if (!records.length) {
          document.getElementById('table-orders').innerHTML =
            '<p class="text-muted p-3">No orders found.</p>';
          return;
        }
        let html = '<div class="table-responsive"><table class="table table-sm table-striped table-hover mb-0">';
        html += '<thead class="table-light"><tr><th>ID</th><th>User ID</th><th>Total Amount</th><th>Status</th><th>Created</th></tr></thead><tbody>';
        records.forEach(record => {
          const statusClass = { 'completed': 'bg-success', 'shipped': 'bg-info', 'processing': 'bg-warning text-dark', 'pending': 'bg-secondary' }[record.status] || 'bg-light text-dark';
          const createdAt = record.created_at ? new Date(record.created_at).toLocaleDateString() : '';
          html += '<tr>';
          html += '<td><small class="text-muted">#' + record.id + '</small></td>';
          html += '<td><small>#' + record.user_id + '</small></td>';
          html += '<td class="fw-semibold">$' + parseFloat(record.total_amount || 0).toFixed(2) + '</td>';
          html += '<td><span class="badge ' + statusClass + '">' + escHtml(record.status || '') + '</span></td>';
          html += '<td><small>' + createdAt + '</small></td>';
          html += '</tr>';
        });
        html += '</tbody></table></div>';
        document.getElementById('table-orders').innerHTML = html;
      }

      function escHtml(str) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
      }
    </script>

  <% end %>
</div>
