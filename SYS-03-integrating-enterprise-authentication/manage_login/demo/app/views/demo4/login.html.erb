<% content_for :title, "Demo 4: Login" %>

<div class="container py-5">
  
  <%# Flash Messages %>
  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle me-2"></i><%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% end %>
  <% if flash[:alert] %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="bi bi-exclamation-triangle me-2"></i><%= flash[:alert] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% end %>

  <%# Back Button %>
  <div class="row mb-4">
    <div class="col">
      <%= link_to demo4_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i> Back to Demo 4
      <% end %>
    </div>
  </div>

  <%# Login Form %>
  <div class="row">
    <div class="col-lg-5 mx-auto">
      <div class="card shadow">
        <div class="card-header text-white" style="background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);">
          <h5 class="mb-0">
            <i class="bi bi-box-arrow-in-right me-2"></i>
            Enterprise Login
          </h5>
        </div>
        <div class="card-body p-4">
          <p class="text-muted text-center mb-4">
            Login with your enterprise credentials to access AIsuru.
          </p>
          
          <div class="alert alert-info text-center mb-4">
            <strong>Demo credentials:</strong><br>
            Email: <code>demo@demo.com</code><br>
            Password: <code>demodemo</code>
          </div>

          <%= form_with url: demo4_authenticate_path, method: :post, local: true do |f| %>
            <div class="mb-3">
              <label for="email" class="form-label">Email address</label>
              <%= f.email_field :email, class: "form-control", required: true, value: "demo@demo.com" %>
            </div>
            <div class="mb-4">
              <label for="password" class="form-label">Password</label>
              <%= f.password_field :password, class: "form-control", required: true, value: "demodemo" %>
            </div>
            <div class="d-grid">
              <%= f.submit "Login", class: "btn btn-lg text-white", style: "background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);" %>
            </div>
          <% end %>
        </div>
        <div class="card-footer bg-light">
          <p class="small text-muted mb-0 text-center">
            <i class="bi bi-info-circle me-1"></i>
            After login, you'll be able to redirect to the AIsuru platform.
          </p>
        </div>
      </div>
    </div>
  </div>

</div>

