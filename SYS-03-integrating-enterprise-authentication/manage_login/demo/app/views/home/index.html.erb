<% content_for :title, "Embedded Web Component Authentication - Demo Selection" %>

<div class="container py-5">
  
  <%# Hero Section %>
  <div class="row mb-5">
    <div class="col-lg-10 mx-auto text-center">
      <h1 class="display-4 fw-bold mb-3">
        <i class="bi bi-shield-lock text-primary me-2"></i>
        Embedded Web Component Authentication
      </h1>
      <p class="lead text-muted mb-4">
        Learn how to integrate AIsuru authentication in your embedded web component.
        Choose a demo to explore different authentication approaches.
      </p>
      <div class="badge bg-info text-white fs-6 px-3 py-2">
        <i class="bi bi-book me-1"></i>
        SYS-03 Module - System Integrator Course
      </div>
    </div>
  </div>

  <%# Demo Cards - Row 1 %>
  <div class="row g-4 mb-4">
    
    <%# Demo 1 Card %>
    <div class="col-lg-6">
      <div class="card h-100 shadow-lg border-0 card-hover">
        <div class="card-header bg-success text-white py-3">
          <h4 class="mb-0">
            <i class="bi bi-1-circle me-2"></i>
            Demo 1: Self-Managed Login
          </h4>
        </div>
        <div class="card-body p-4">
          <div class="mb-4">
            <span class="badge bg-success-subtle text-success me-2">Beginner</span>
            <span class="badge bg-light text-dark">No Backend</span>
          </div>
          
          <h5 class="card-title">Web Component with <code>showLogin="true"</code></h5>
          <p class="card-text text-muted">
            The simplest approach: let the web component handle authentication autonomously.
          </p>
          
          <hr>
          
          <h6 class="text-muted mb-3">What you'll learn:</h6>
          <ul class="list-unstyled small">
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Configure agent credentials
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Use <code>showLogin="true"</code>
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              CSS embedding techniques
            </li>
          </ul>
          
          <hr>
          
          <h6 class="text-muted mb-3">Use case:</h6>
          <p class="small text-muted mb-0">
            <i class="bi bi-lightbulb text-warning me-1"></i>
            Quick integration, users manage own AIsuru accounts.
          </p>
        </div>
        <div class="card-footer bg-white border-0 p-4">
          <%= link_to demo1_path, class: "btn btn-success btn-lg w-100" do %>
            <i class="bi bi-play-circle me-2"></i>
            Start Demo 1
          <% end %>
        </div>
      </div>
    </div>
    
    <%# Demo 2 Card %>
    <div class="col-lg-6">
      <div class="card h-100 shadow-lg border-0 card-hover">
        <div class="card-header bg-primary text-white py-3">
          <h4 class="mb-0">
            <i class="bi bi-2-circle me-2"></i>
            Demo 2: Programmatic Auth
          </h4>
        </div>
        <div class="card-body p-4">
          <div class="mb-4">
            <span class="badge bg-primary-subtle text-primary me-2">Advanced</span>
            <span class="badge bg-warning-subtle text-warning">Trusted App</span>
          </div>
          
          <h5 class="card-title">Backend Auth with <code>LoginWithJWT</code></h5>
          <p class="card-text text-muted">
            Integrate AIsuru with your existing user system via backend authentication.
          </p>
          
          <hr>
          
          <h6 class="text-muted mb-3">What you'll learn:</h6>
          <ul class="list-unstyled small">
            <li class="mb-2">
              <i class="bi bi-check-circle text-primary me-2"></i>
              Create Trusted App
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-primary me-2"></i>
              Use <code>LoginWithJWT</code> API
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-primary me-2"></i>
              Pass <code>loginToken</code>
            </li>
          </ul>
          
          <hr>
          
          <h6 class="text-muted mb-3">Use case:</h6>
          <p class="small text-muted mb-0">
            <i class="bi bi-lightbulb text-warning me-1"></i>
            Enterprise apps with existing user databases.
          </p>
        </div>
        <div class="card-footer bg-white border-0 p-4">
          <%= link_to demo2_path, class: "btn btn-primary btn-lg w-100" do %>
            <i class="bi bi-play-circle me-2"></i>
            Start Demo 2
          <% end %>
        </div>
      </div>
    </div>
    
  </div>

  <%# Demo Cards - Row 2 %>
  <div class="row g-4 mb-5">
    
    <%# Demo 3 Card %>
    <div class="col-lg-6">
      <div class="card h-100 shadow-lg border-0 card-hover">
        <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #00a4ef 0%, #0078d4 100%);">
          <h4 class="mb-0">
            <i class="bi bi-3-circle me-2"></i>
            Demo 3: Microsoft SSO
          </h4>
        </div>
        <div class="card-body p-4">
          <div class="mb-4">
            <span class="badge bg-info-subtle text-info me-2">Enterprise</span>
            <span class="badge bg-warning-subtle text-warning">Azure AD</span>
          </div>
          
          <h5 class="card-title">Microsoft Entra ID + AIsuru</h5>
          <p class="card-text text-muted">
            Complete SSO integration with Microsoft Azure AD / Entra ID.
          </p>
          
          <hr>
          
          <h6 class="text-muted mb-3">What you'll learn:</h6>
          <ul class="list-unstyled small">
            <li class="mb-2">
              <i class="bi bi-check-circle text-info me-2"></i>
              Azure App Registration
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-info me-2"></i>
              MSAL.js integration
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-info me-2"></i>
              MS → AIsuru token flow
            </li>
          </ul>
          
          <hr>
          
          <h6 class="text-muted mb-3">Use case:</h6>
          <p class="small text-muted mb-0">
            <i class="bi bi-lightbulb text-warning me-1"></i>
            Corporate environments using Microsoft 365.
          </p>
        </div>
        <div class="card-footer bg-white border-0 p-4">
          <%= link_to demo3_path, class: "btn btn-lg w-100 text-white", style: "background: linear-gradient(135deg, #00a4ef 0%, #0078d4 100%);" do %>
            <i class="bi bi-play-circle me-2"></i>
            Start Demo 3
          <% end %>
        </div>
      </div>
    </div>
    
    <%# Demo 4 Card %>
    <div class="col-lg-6">
      <div class="card h-100 shadow-lg border-0 card-hover">
        <div class="card-header text-white py-3" style="background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);">
          <h4 class="mb-0">
            <i class="bi bi-4-circle me-2"></i>
            Demo 4: Login with Redirect
          </h4>
        </div>
        <div class="card-body p-4">
          <div class="mb-4">
            <span class="badge bg-purple-subtle text-purple me-2" style="background-color: #ede9fe !important; color: #7c3aed !important;">Enterprise</span>
            <span class="badge bg-warning-subtle text-warning">Magic Link</span>
          </div>
          
          <h5 class="card-title">Redirect to AIsuru Tenant</h5>
          <p class="card-text text-muted">
            Authenticate users in your app, then redirect them to the AIsuru platform.
          </p>
          
          <hr>
          
          <h6 class="text-muted mb-3">What you'll learn:</h6>
          <ul class="list-unstyled small">
            <li class="mb-2">
              <i class="bi bi-check-circle me-2" style="color: #8b5cf6;"></i>
              Enterprise login flow
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle me-2" style="color: #8b5cf6;"></i>
              Magic link URL format
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle me-2" style="color: #8b5cf6;"></i>
              Redirect to tenant platform
            </li>
          </ul>
          
          <hr>
          
          <h6 class="text-muted mb-3">Use case:</h6>
          <p class="small text-muted mb-0">
            <i class="bi bi-lightbulb text-warning me-1"></i>
            Enterprise portals linking to AIsuru.
          </p>
        </div>
        <div class="card-footer bg-white border-0 p-4">
          <%= link_to demo4_path, class: "btn btn-lg w-100 text-white", style: "background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);" do %>
            <i class="bi bi-play-circle me-2"></i>
            Start Demo 4
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Comparison Table %>
  <div class="row">
    <div class="col-lg-12 mx-auto">
      <div class="card border-0 shadow">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0">
            <i class="bi bi-table me-2"></i>
            Comparison: Which approach to choose?
          </h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-striped mb-0">
              <thead class="table-light">
                <tr>
                  <th>Feature</th>
                  <th class="text-center">Demo 1: showLogin</th>
                  <th class="text-center">Demo 2: Trusted App</th>
                  <th class="text-center">Demo 3: Microsoft SSO</th>
                  <th class="text-center">Demo 4: Redirect</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Backend changes required</td>
                  <td class="text-center"><i class="bi bi-x-circle text-danger"></i> No</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                </tr>
                <tr>
                  <td>SSO with existing users</td>
                  <td class="text-center"><i class="bi bi-x-circle text-danger"></i> No</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                </tr>
                <tr>
                  <td>Embedded web component</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                  <td class="text-center"><i class="bi bi-x-circle text-danger"></i> No</td>
                </tr>
                <tr>
                  <td>Redirects to AIsuru platform</td>
                  <td class="text-center"><i class="bi bi-x-circle text-danger"></i> No</td>
                  <td class="text-center"><i class="bi bi-x-circle text-danger"></i> No</td>
                  <td class="text-center"><i class="bi bi-x-circle text-danger"></i> No</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                </tr>
                <tr>
                  <td>External IdP required</td>
                  <td class="text-center"><i class="bi bi-x-circle text-danger"></i> No</td>
                  <td class="text-center"><i class="bi bi-x-circle text-danger"></i> No</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Azure AD</td>
                  <td class="text-center"><i class="bi bi-x-circle text-danger"></i> No</td>
                </tr>
                <tr>
                  <td>Requires Tenant Admin access</td>
                  <td class="text-center"><i class="bi bi-x-circle text-danger"></i> No</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                  <td class="text-center"><i class="bi bi-check-circle text-success"></i> Yes</td>
                </tr>
                <tr>
                  <td>Complexity</td>
                  <td class="text-center"><span class="badge bg-success">Low</span></td>
                  <td class="text-center"><span class="badge bg-warning text-dark">Medium</span></td>
                  <td class="text-center"><span class="badge bg-danger">High</span></td>
                  <td class="text-center"><span class="badge bg-warning text-dark">Medium</span></td>
                </tr>
                <tr>
                  <td>Best for</td>
                  <td class="text-center">Public websites</td>
                  <td class="text-center">Custom user systems</td>
                  <td class="text-center">Microsoft 365 orgs</td>
                  <td class="text-center">Enterprise portals</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Resources %>
  <div class="row mt-5">
    <div class="col-lg-10 mx-auto">
      <div class="alert alert-info d-flex align-items-start">
        <i class="bi bi-info-circle-fill fs-4 me-3"></i>
        <div>
          <h6 class="alert-heading mb-2">📚 Additional Resources</h6>
          <ul class="mb-0 small">
            <li><a href="https://docs.aisuru.com/" target="_blank">AIsuru Documentation</a></li>
            <li><a href="https://docs.aisuru.com/api/backend/pwluser" target="_blank">PwlUser API Reference (LoginWithJWT)</a></li>
            <li><a href="https://docs.aisuru.com/api/backend/trustedapplication" target="_blank">Trusted Application API</a></li>
            <li><a href="https://www.npmjs.com/package/@memori.ai/memori-webcomponent" target="_blank">Web Component NPM Package</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

</div>
