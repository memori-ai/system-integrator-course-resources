<% content_for :title, "Demo 2: Programmatic Auth with Trusted App" %>

<div class="container py-5">
  
  <%# Back to Home %>
  <div class="row mb-4">
    <div class="col">
      <%= link_to root_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i> Back to Demo Selection
      <% end %>
    </div>
  </div>

  <%# Hero Section %>
  <div class="row mb-5">
    <div class="col-lg-10 mx-auto text-center">
      <span class="badge bg-primary mb-3">Demo 2</span>
      <h1 class="display-5 fw-bold mb-3">
        <i class="bi bi-key text-primary me-2"></i>
        Programmatic Authentication
      </h1>
      <p class="lead text-muted">
        Authenticate users through your backend using AIsuru Trusted App and <code>LoginWithJWT</code> API.
        The web component receives the auth token directly - seamless SSO experience!
      </p>
    </div>
  </div>

  <div class="row g-4">
    
    <%# Left Column: Configuration & Login %>
    <div class="col-lg-5">
      
      <%# Step 1: Trusted App Configuration %>
      <div class="card shadow mb-4">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0">
            <i class="bi bi-1-circle me-2"></i>
            Step 1: Configure Trusted App
          </h5>
        </div>
        <div class="card-body">
          <% if @aisuru_configured %>
            <div class="alert alert-success mb-3">
              <i class="bi bi-check-circle me-1"></i>
              <strong>Configured!</strong> Trusted App is ready.
            </div>
          <% end %>
          
          <%= form_with url: demo2_configure_path, method: :post, local: true do |f| %>
            <div class="mb-3">
              <label for="memori_id" class="form-label fw-bold">
                Memori ID <span class="text-danger">*</span>
              </label>
              <%= f.text_field :memori_id, 
                  class: "form-control", 
                  value: @memori_id,
                  placeholder: "a1b2c3d4-e5f6-...",
                  required: true %>
            </div>

            <div class="mb-3">
              <label for="owner_user_id" class="form-label fw-bold">
                Owner User ID <span class="text-danger">*</span>
              </label>
              <%= f.text_field :owner_user_id, 
                  class: "form-control", 
                  value: @owner_user_id,
                  placeholder: "b2c3d4e5-f6a7-...",
                  required: true %>
            </div>

            <div class="mb-3">
              <label for="trusted_app_api_key" class="form-label fw-bold">
                <i class="bi bi-key-fill text-warning me-1"></i>
                Trusted App API Key <span class="text-danger">*</span>
              </label>
              <%= f.password_field :trusted_app_api_key, 
                  class: "form-control", 
                  value: @trusted_app_api_key,
                  placeholder: "Your Trusted App API Key",
                  required: true %>
              <div class="form-text">
                <i class="bi bi-info-circle me-1"></i>
                Get this from <strong>Admin → Trusted Apps</strong> in your AIsuru tenant
              </div>
            </div>

            <hr>
            <h6 class="text-muted mb-3">Endpoints (defaults for aisuru.com)</h6>

            <div class="row">
              <div class="col-6 mb-2">
                <label class="form-label small">Tenant ID</label>
                <%= f.text_field :tenant_id, class: "form-control form-control-sm", value: @tenant_id %>
              </div>
              <div class="col-6 mb-2">
                <label class="form-label small">Base URL</label>
                <%= f.text_field :base_url, class: "form-control form-control-sm", value: @base_url %>
              </div>
            </div>
            <div class="mb-2">
              <label class="form-label small">API URL</label>
              <%= f.text_field :api_url, class: "form-control form-control-sm", value: @api_url %>
            </div>
            <div class="mb-3">
              <label class="form-label small">Engine URL</label>
              <%= f.text_field :engine_url, class: "form-control form-control-sm", value: @engine_url %>
            </div>

            <div class="d-grid">
              <%= f.submit "Save Configuration", class: "btn btn-warning" %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Step 2: User Login %>
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">
            <i class="bi bi-2-circle me-2"></i>
            Step 2: User Login
          </h5>
        </div>
        <div class="card-body">
          <% if @current_user %>
            <%# User is logged in %>
            <div class="alert alert-success mb-3">
              <div class="d-flex align-items-center">
                <i class="bi bi-person-check-fill fs-3 me-3"></i>
                <div>
                  <strong>Logged in as:</strong><br>
                  <span class="font-monospace"><%= @current_user.email %></span>
                </div>
              </div>
            </div>
            
            <% if @current_user.aisuru_authenticated? %>
              <div class="alert alert-info mb-3">
                <i class="bi bi-shield-check me-1"></i>
                <strong>AIsuru Token:</strong>
                <div class="font-monospace small text-truncate mt-1">
                  <%= @current_user.aisuru_token %>
                </div>
              </div>
            <% else %>
              <div class="alert alert-warning mb-3">
                <i class="bi bi-exclamation-triangle me-1"></i>
                No AIsuru token. Configure Trusted App and re-login.
              </div>
            <% end %>
            
            <%= button_to "Logout", demo2_logout_path, method: :delete, class: "btn btn-outline-danger w-100" %>
          <% else %>
            <%# User is not logged in %>
            <div class="alert alert-light mb-3">
              <i class="bi bi-info-circle me-1"></i>
              <strong>Demo User:</strong><br>
              Email: <code>demo@demo.com</code><br>
              Password: <code>demodemo</code>
            </div>
            
            <%= link_to demo2_login_path, class: "btn btn-primary w-100" do %>
              <i class="bi bi-box-arrow-in-right me-1"></i>
              Go to Login Page
            <% end %>
          <% end %>
        </div>
      </div>

    </div>

    <%# Right Column: Web Component %>
    <div class="col-lg-7">
      
      <% if @current_user&.aisuru_authenticated? && @aisuru_configured %>
        <%# Show authenticated web component %>
        <div class="card shadow">
          <div class="card-header bg-success text-white">
            <h5 class="mb-0">
              <i class="bi bi-robot me-2"></i>
              Authenticated Agent
              <span class="badge bg-white text-success ms-2">Token Passed</span>
            </h5>
          </div>
          <div class="card-body p-0">
            <div class="memori-container">
              <memori-client
                memoriName="YourAgent"
                ownerUserName="owner"
                memoriID="<%= @memori_id %>"
                ownerUserID="<%= @owner_user_id %>"
                tenantID="<%= @tenant_id %>"
                engineURL="<%= @engine_url %>"
                apiURL="<%= @api_url %>"
                baseURL="<%= @base_url %>"
                layout="CHAT"
                uiLang="EN"
                spokenLang="EN"
                showLogin="false"
                additionalInfo='{"loginToken":"<%= @current_user.aisuru_token %>"}'
              ></memori-client>
            </div>
          </div>
        </div>

        <%# Code Example %>
        <div class="card border-dark mt-4">
          <div class="card-header bg-dark text-white">
            <h6 class="mb-0">
              <i class="bi bi-file-code me-2"></i>
              HTML with Pre-Authenticated Token
            </h6>
          </div>
          <div class="card-body bg-light">
            <pre class="mb-0 small"><code>&lt;memori-client
  memoriID="<%= @memori_id %>"
  ownerUserID="<%= @owner_user_id %>"
  tenantID="<%= @tenant_id %>"
  ...
  <strong>showLogin="false"</strong>
  <strong>additionalInfo='{"loginToken":"<%= @current_user.aisuru_token[0..20] %>..."}'</strong>
&gt;&lt;/memori-client&gt;</code></pre>
          </div>
        </div>

      <% else %>
        <%# Show instructions %>
        <div class="card shadow h-100">
          <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">
              <i class="bi bi-robot me-2"></i>
              Agent Preview
            </h5>
          </div>
          <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-5">
            <i class="bi bi-lock display-1 text-muted mb-4"></i>
            <h4 class="text-muted">Complete the steps to see the agent</h4>
            <p class="text-muted mb-4">
              <% unless @aisuru_configured %>
                <i class="bi bi-x-circle text-danger me-1"></i>
                Configure Trusted App (Step 1)<br>
              <% else %>
                <i class="bi bi-check-circle text-success me-1"></i>
                Trusted App configured<br>
              <% end %>
              <% unless @current_user %>
                <i class="bi bi-x-circle text-danger me-1"></i>
                Login with demo user (Step 2)
              <% else %>
                <i class="bi bi-check-circle text-success me-1"></i>
                User logged in
                <% unless @current_user.aisuru_authenticated? %>
                  <br><i class="bi bi-exclamation-triangle text-warning me-1"></i>
                  Re-login to get AIsuru token
                <% end %>
              <% end %>
            </p>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <%# How it Works Section %>
  <div class="row mt-5">
    <div class="col-12">
      <div class="card border-info">
        <div class="card-header bg-info text-white">
          <h5 class="mb-0">
            <i class="bi bi-diagram-3 me-2"></i>
            How Programmatic Authentication Works
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-4">
            <div class="col-md-3 text-center">
              <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-person-badge display-5 text-primary"></i>
              </div>
              <h6>1. User Logs In</h6>
              <p class="small text-muted mb-0">User authenticates with your app's login system</p>
            </div>
            <div class="col-md-3 text-center">
              <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-server display-5 text-warning"></i>
              </div>
              <h6>2. Backend Calls API</h6>
              <p class="small text-muted mb-0">Your backend uses Trusted App to call <code>LoginWithJWT</code></p>
            </div>
            <div class="col-md-3 text-center">
              <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-key-fill display-5 text-success"></i>
              </div>
              <h6>3. Get Token</h6>
              <p class="small text-muted mb-0">AIsuru returns a <code>loginToken</code> for the user</p>
            </div>
            <div class="col-md-3 text-center">
              <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-chat-dots display-5 text-info"></i>
              </div>
              <h6>4. Pass to Component</h6>
              <p class="small text-muted mb-0">Token is passed via <code>additionalInfo.loginToken</code></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Trusted App Info %>
  <div class="row mt-4">
    <div class="col-12">
      <div class="card border-warning">
        <div class="card-header bg-warning text-dark">
          <h5 class="mb-0">
            <i class="bi bi-shield-exclamation me-2"></i>
            About Trusted Applications
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <h6><i class="bi bi-question-circle me-1"></i> What is a Trusted App?</h6>
              <p class="text-muted">
                A Trusted Application is a secure way for your backend to communicate with AIsuru APIs.
                It allows you to authenticate users programmatically without them entering credentials.
              </p>
              <h6><i class="bi bi-person-gear me-1"></i> Who can create Trusted Apps?</h6>
              <p class="text-muted mb-0">
                Only <strong>Tenant Administrators</strong> can create Trusted Applications.
                Go to <strong>Admin → Trusted Apps</strong> in your AIsuru dashboard.
              </p>
            </div>
            <div class="col-md-6">
              <h6><i class="bi bi-gear me-1"></i> API Call Requirements:</h6>
              <ul class="text-muted small">
                <li><strong>Endpoint</strong>: <code>POST /api/v2/LoginWithJWT</code></li>
                <li><strong>Header</strong>: <code>X-Memori-Trusted-App: YOUR_API_KEY</code></li>
                <li><strong>Body</strong>: <code>{"tenant": "...", "jwtToken": "..."}</code></li>
                <li><strong>JWT Signing</strong>: Use HS256 with your API Key</li>
              </ul>
              <div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-triangle me-1"></i>
                <strong>Security:</strong> Never expose your API Key in frontend code!
                Always call AIsuru APIs from your backend.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

