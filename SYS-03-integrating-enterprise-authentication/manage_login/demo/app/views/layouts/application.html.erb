<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for(:title) || "AIsuru Web Component Demo" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Bootstrap CSS CDN %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <%# Bootstrap Icons CDN %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <%# AIsuru Web Component %>
    <script type="module" src="https://cdn.jsdelivr.net/npm/@memori.ai/memori-webcomponent/dist/memori-webcomponent.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@memori.ai/memori-react/dist/styles.min.css" />
    
    <%# Bootstrap JS Bundle CDN (include Popper) %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    
    <%# Microsoft MSAL.js for Demo 3 %>
    <script src="https://alcdn.msauth.net/browser/2.30.0/js/msal-browser.min.js"></script>
    
    <%= javascript_importmap_tags %>

    <style>
      .hero-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      }
      .card-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        transition: all 0.3s ease;
      }
      .card-hover {
        transition: all 0.3s ease;
      }
      
      /* Container for AIsuru Web Component */
      .memori-container {
        position: relative;
        width: 100%;
        height: 600px;
        overflow: hidden;
        border-radius: 0 0 0.375rem 0.375rem;
      }
      
      /* Force web component to stay contained */
      .memori-container memori-client {
        display: block;
        width: 100%;
        height: 100%;
        position: relative;
      }
      
      /* Override fixed positioning inside the web component */
      .memori-container memori-client .memori-widget,
      .memori-container memori-client .memori {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100% !important;
        height: 100% !important;
      }
      
      /* Contain the fixed toast notifications */
      .memori-container memori-client > div > div[style*="position: fixed"] {
        position: absolute !important;
      }
      
      /* Ensure background stays contained */
      .memori-container .memori--global-background,
      .memori-container .memori--global-background-image {
        position: absolute !important;
        border-radius: 0 0 0.375rem 0.375rem;
      }
    </style>
  </head>

  <body class="bg-light">
    <%# Navbar %>
    <nav class="navbar navbar-expand-lg navbar-dark hero-gradient">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
          <i class="bi bi-robot fs-4 me-2"></i>
          <strong>AIsuru Web Component Demo</strong>
        <% end %>
        <div class="navbar-text text-white-50">
          <small>SYS-03: Embedded Authentication</small>
        </div>
      </div>
    </nav>

    <%# Flash Messages %>
    <% if flash[:notice] %>
      <div class="alert alert-success alert-dismissible fade show m-0" role="alert">
        <%= flash[:notice] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="alert alert-danger alert-dismissible fade show m-0" role="alert">
        <%= flash[:alert] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>

    <%# Main Content %>
    <main>
      <%= yield %>
    </main>

    <%# Footer %>
    <footer class="bg-dark text-white-50 py-4 mt-5">
      <div class="container text-center">
        <p class="mb-1">
          <i class="bi bi-book me-1"></i>
          AIsuru System Integrator Course - Module SYS-03
        </p>
        <small>
          <a href="https://docs.aisuru.com" target="_blank" class="text-white-50">Documentation</a>
          <span class="mx-2">|</span>
          <a href="https://www.aisuru.com" target="_blank" class="text-white-50">AIsuru Platform</a>
          <span class="mx-2">|</span>
          <a href="https://memori.ai" target="_blank" class="text-white-50">Memori.ai</a>
        </small>
      </div>
    </footer>
  </body>
</html>

